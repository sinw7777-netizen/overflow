<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#292929">
<title>편입 준비 한눈에</title>
<style>
:root {
  --ink: #222222;
  --muted: #777777;
  --line: #e2e2e2;
  --paper: #ffffff;
  --bg: #f4f4f4;
  --soft: #f8f8f8;
  --accent: #111111;
  --primary: #2563eb;
  --primary-light: #eff6ff;
  --tag-bg: #f3f4f6;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: system-ui, -apple-system, "Noto Sans KR", sans-serif;
  -webkit-tap-highlight-color: transparent;
  display: flex;
  justify-content: center;
}

button, input, select { font: inherit; }
button { cursor: pointer; }

.app {
  width: 100%;
  max-width: 430px;
  min-height: 100vh;
  min-height: 100dvh;
  margin: 0 auto;
  background: var(--paper);
  padding-bottom: calc(78px + env(safe-area-inset-bottom));
  box-shadow: 0 0 20px rgba(0,0,0,0.05);
  position: relative;
}

header {
  padding: 16px 18px 14px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  z-index: 5;
}

.brand {
  font-weight: 800;
  font-size: 16px;
  display: flex;
  gap: 8px;
  align-items: center;
}

.cap {
  width: 26px;
  height: 26px;
  border-radius: 7px;
  background: var(--accent);
  color: white;
  display: grid;
  place-items: center;
  font-size: 12px;
}

.header-note { font-size: 11px; color: var(--muted); font-weight: 600; }

main { padding: 20px 16px 24px; }

.eyebrow {
  font-size: 10px;
  letter-spacing: .1em;
  color: var(--muted);
  font-weight: 700;
  margin-bottom: 6px;
}

h1 { font-size: 22px; line-height: 1.35; margin: 0 0 8px; letter-spacing: -0.03em; font-weight: 800; }
h2 { font-size: 18px; margin: 0 0 6px; letter-spacing: -0.02em; font-weight: 700; }
h3 { font-size: 15px; margin: 0 0 6px; font-weight: 700; }
p { line-height: 1.55; margin: 0; }
.sub { color: var(--muted); font-size: 13px; margin: 0 0 16px; line-height: 1.45; }

.hero {
  background: var(--soft);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px;
  margin: 6px 0 16px;
}
.hero p { font-size: 13px; margin: 0 0 12px; color: #555; }

.btn {
  border: 1px solid var(--accent);
  border-radius: 10px;
  padding: 12px 14px;
  background: var(--accent);
  color: white;
  font-weight: 700;
  width: 100%;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  transition: opacity .15s;
}
.btn:active { opacity: 0.85; }
.btn.secondary { background: white; color: var(--ink); border-color: #cccccc; }
.btn.ghost { background: var(--soft); color: #333; border-color: var(--line); }
.btn.small { width: auto; min-height: 32px; padding: 5px 12px; font-size: 12px; }
.btn.danger { background: #fee2e2; color: #b91c1c; border-color: #fca5a5; }

.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.tile, .card { border: 1px solid var(--line); border-radius: 12px; padding: 14px; background: white; position: relative; }
.tile { display: flex; flex-direction: column; justify-content: space-between; gap: 6px; text-align: left; min-height: 92px; width: 100%; }
.tile b { font-size: 13px; color: var(--ink); }
.tile span { font-size: 11px; color: var(--muted); }

.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 12px 0; }
.stat { padding: 12px; border-radius: 12px; background: var(--soft); border: 1px solid var(--line); }
.stat strong { font-size: 19px; display: block; color: var(--ink); }
.stat span { font-size: 11px; color: var(--muted); }

/* 홈 우측 뱃지 순위 영역 */
.rank-badges { display: flex; flex-direction: column; gap: 5px; margin-top: 6px; }
.rank-badge {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 7px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 6px;
  font-size: 11px;
  cursor: pointer;
  text-align: left;
}
.rank-badge.active {
  border-color: var(--accent);
  background: #fdfdfd;
  font-weight: 700;
}
.rank-badge small { color: var(--muted); font-size: 10px; margin-left: 4px; }

.progress { height: 7px; background: #e5e5e5; border-radius: 20px; overflow: hidden; margin: 8px 0; }
.progress i { display: block; height: 100%; background: var(--accent); border-radius: 20px; transition: width .2s; }

.section-head { display: flex; align-items: center; justify-content: space-between; margin: 18px 0 10px; }

/* 대학 전환 탭 바 */
.tab-scroll-container {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding-bottom: 6px;
  margin-bottom: 12px;
  -webkit-overflow-scrolling: touch;
}
.tab-scroll-container::-webkit-scrollbar { display: none; }
.pill-tab {
  padding: 6px 12px;
  border-radius: 20px;
  border: 1px solid var(--line);
  background: white;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  color: var(--muted);
}
.pill-tab.active {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
}

/* 목표 대학 드래그 앤 드롭 카드 스타일 */
.target-card {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 10px;
  background: white;
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  user-select: none;
}
.target-card.dragging {
  opacity: 0.55;
  box-shadow: 0 10px 20px rgba(0,0,0,0.12);
  transform: scale(0.98);
  border-color: var(--primary);
}
.target-card.drag-over {
  border-top: 2.5px solid var(--primary);
}
.target-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.badge-priority {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 12px;
  background: #e5e7eb;
  color: #374151;
}
.badge-priority.p1 { background: #fef3c7; color: #92400e; }
.badge-priority.p2 { background: #e0e7ff; color: #3730a3; }
.badge-priority.p3 { background: #f1f5f9; color: #475569; }

/* 순위 이동 드래그 핸들 (≡ 아이콘) */
.drag-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 28px;
  color: #999;
  font-size: 18px;
  cursor: grab;
  touch-action: none; /* 모바일에서 스크롤 방지하고 드래그 우선 */
}
.drag-handle:active {
  cursor: grabbing;
  color: var(--accent);
}

/* 폼 요소 */
label { display: block; font-size: 13px; font-weight: 700; margin: 14px 0 6px; }
select, input[type=text] {
  width: 100%;
  padding: 11px;
  border: 1px solid #cccccc;
  border-radius: 8px;
  background: white;
  color: #222;
  min-height: 44px;
  font-size: 14px;
}
select:focus, input[type=text]:focus { outline: none; border-color: var(--accent); }
.form-hint { font-size: 11px; color: var(--muted); margin: 6px 0 0; line-height: 1.4; }
.actions { display: flex; gap: 8px; margin-top: 16px; }
.actions > * { flex: 1; }

.item {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 13px 14px;
  margin: 8px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  background: white;
}
.item p { font-size: 12px; color: var(--muted); margin: 3px 0 0; }
.arrow { font-size: 18px; color: #777; }

/* 안내 전용 카드 스타일 */
.guide-box {
  background: var(--soft);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px;
  margin: 12px 0;
}
.guide-row { margin-bottom: 12px; }
.guide-row:last-child { margin-bottom: 0; }
.guide-row strong { display: block; font-size: 13px; color: var(--accent); margin-bottom: 3px; }
.guide-row p { font-size: 13px; color: #444; line-height: 1.5; }

.info { background: var(--soft); border: 1px solid var(--line); border-radius: 10px; padding: 12px; font-size: 12px; line-height: 1.55; color: #555; margin: 12px 0; }
.status-badge { display: inline-block; border-radius: 20px; background: #e0f2fe; color: #0369a1; padding: 4px 10px; font-size: 11px; margin: 4px 0 10px; font-weight: 700; }
.check-row { display: flex; align-items: flex-start; gap: 10px; padding: 12px 2px; border-bottom: 1px solid var(--line); font-size: 13px; }
.check-row input { width: 18px; height: 18px; accent-color: var(--accent); flex: none; margin: 1px 0 0; }
.check-row small { display: block; color: var(--muted); font-size: 11px; margin-top: 3px; }

/* 설정 탭 1순위 엠블럼 워터마크 카드 */
.emblem-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 20px;
  background: #ffffff;
  min-height: 140px;
}
.emblem-watermark {
  position: absolute;
  right: -15px;
  bottom: -20px;
  width: 140px;
  height: 140px;
  opacity: 0.08;
  pointer-events: none;
  z-index: 1;
}
.emblem-content {
  position: relative;
  z-index: 2;
}

/* AI 모달 (시뮬레이션 로딩) */
.ai-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
}
.ai-modal-backdrop.show { opacity: 1; pointer-events: auto; }
.ai-modal {
  background: white;
  width: min(340px, 86%);
  border-radius: 16px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}
.ai-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #f3f3f3;
  border-top: 3px solid var(--accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.ai-modal h3 { font-size: 16px; margin: 0 0 6px; }
.ai-modal p { font-size: 12px; color: var(--muted); margin: 0 0 16px; }
.ai-progress-track { width: 100%; height: 6px; background: #eee; border-radius: 10px; overflow: hidden; }
.ai-progress-bar { width: 0%; height: 100%; background: var(--accent); transition: width .3s ease; }

/* 하단 탭바 & 토스트 */
.bottom {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(430px, 100%);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid var(--line);
  padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
  z-index: 6;
  backdrop-filter: blur(10px);
}
.nav {
  border: 0;
  background: transparent;
  color: #888888;
  font-size: 10px;
  padding: 4px 2px;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 2px;
}
.nav b { font-size: 17px; font-weight: 500; }
.nav.active { color: var(--accent); font-weight: 800; }

.back { border: 0; background: transparent; font-size: 20px; padding: 0 8px 0 0; display: inline-flex; align-items: center; }
.topline { display: flex; align-items: center; margin-bottom: 14px; min-height: 28px; }
.topline h2 { flex: 1; margin: 0; font-size: 18px; }

.toast {
  position: fixed;
  bottom: calc(72px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  background: #222222;
  color: white;
  padding: 9px 16px;
  border-radius: 30px;
  font-size: 12px;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
  z-index: 10;
  white-space: nowrap;
}
.toast.show { opacity: 1; }
footer { padding: 0 16px 20px; color: #999999; font-size: 10px; text-align: center; }
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand"><span class="cap">▰</span> 편입 준비 한눈에</div>
    <span class="header-note">AI TRANSFER GUIDE</span>
  </header>
  
  <main id="screen" aria-live="polite"></main>
  
  <footer>입력한 목표 대학과 준비 상태는 브라우저에 자동 보관됩니다.</footer>
  
  <nav class="bottom" aria-label="하단 메뉴">
    <button class="nav active" data-page="home"><b>⌂</b>홈</button>
    <button class="nav" data-page="list"><b>▤</b>준비사항</button>
    <button class="nav" data-page="check"><b>☑</b>체크리스트</button>
    <button class="nav" data-page="profile"><b>○</b>설정</button>
  </nav>
</div>

<!-- AI 분석 시뮬레이션 모달 -->
<div class="ai-modal-backdrop" id="aiModal">
  <div class="ai-modal">
    <div class="ai-spinner"></div>
    <h3 id="aiModalTitle">AI 비서 요강 분석 중...</h3>
    <p id="aiModalDesc">입학처 최신 편입학 공지사항을 스캔하고 있습니다.</p>
    <div class="ai-progress-track">
      <div class="ai-progress-bar" id="aiProgressBar"></div>
    </div>
  </div>
</div>

<div class="toast" id="toast">저장되었습니다.</div>

<script>
const KEY = 'transferPrepApp_drag_v1';

// 대학별 엠블럼 SVG 목업
const EMBLEMS = {
  '인하대학교': `<svg viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="6" fill="none"/><path d="M50 20 L78 75 L62 75 L50 48 L38 75 L22 75 Z"/><circle cx="50" cy="35" r="5"/></svg>`,
  '성균관대학교': `<svg viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="6" fill="none"/><path d="M30 40 C30 25, 70 25, 70 40 C70 55, 30 55, 30 70 C30 85, 70 85, 70 70" stroke="currentColor" stroke-width="7" fill="none"/></svg>`,
  '한양대학교': `<svg viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="6" fill="none"/><polygon points="50,18 80,42 68,80 32,80 20,42" fill="none" stroke="currentColor" stroke-width="5"/><text x="50" y="58" font-size="22" font-weight="bold" text-anchor="middle" fill="currentColor">HY</text></svg>`,
  '중앙대학교': `<svg viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="6" fill="none"/><path d="M30 30 H70 V70 H30 Z" stroke="currentColor" stroke-width="6" fill="none"/><circle cx="50" cy="50" r="10"/></svg>`,
  '연세대학교': `<svg viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="6" fill="none"/><circle cx="50" cy="38" r="16" stroke="currentColor" stroke-width="5" fill="none"/><polygon points="30,76 70,76 50,48" stroke="currentColor" stroke-width="5" fill="none"/></svg>`,
  'default': `<svg viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="6" fill="none"/><polygon points="50,22 82,40 50,56 18,40" stroke="currentColor" stroke-width="4" fill="none"/><path d="M30 46 V66 C30 76, 70 76, 70 66 V46" stroke="currentColor" stroke-width="4" fill="none"/></svg>`
};

// 대학별 모의 수집 요강 데이터베이스
const MOCK_ADMISSION_DATA = {
  '인하대학교': {
    qualification: { title: '지원 자격·학점', list: [{ label: '지원 대상', text: '국내 4년제 대학 2학년(4학기) 이상 수료(예정)자' }, { label: '이수 학점 기준', text: '인하대 기준 65학점 이상 취득자 (전적대 성적 평점 2.0 이상)' }] },
    exam: { title: '시험 과목·범위', list: [{ label: '필기 전형 구성', text: '자연계열: 수학(미적분학, 선형대수) 100% / 인문계열: 영어 100%' }, { label: '선발 방식', text: '필기고사 성적순 100% 일괄 선발 (실기 학과 제외)' }] },
    language: { title: '어학·자격증', list: [{ label: '공인영어 기준', text: '토익/토플 필수 제출 요건 없음 (자체 필답고사 중심 반영)' }, { label: '자격증 가산점', text: '해당 전형 요소 없음' }] },
    schedule: { title: '제출 서류·일정', list: [{ label: '원서 접수 기간', text: '12월 중순 예정 (입학처 인터넷 접수)' }, { label: '필기 시험일', text: '1월 초 주말 실시 예정' }] },
    source: 'https://admission.inha.ac.kr'
  },
  '성균관대학교': {
    qualification: { title: '지원 자격·학점', list: [{ label: '지원 대상', text: '정규 4년제 2학년 4학기 수료(예정)자' }, { label: '이수 학점 기준', text: '65학점 이상 수료 (계열별 인정 학점 상이)' }] },
    exam: { title: '시험 과목·범위', list: [{ label: '필기 전형 구성', text: '영어 60점 + 수학 40점 (통합 90분 평가)' }, { label: '2단계 반영', text: '1단계 성적 70% + 서류평가 30%' }] },
    language: { title: '어학·자격증', list: [{ label: '공인영어 기준', text: '자체 편입영어 필답고사로 대체' }, { label: '서류 제출', text: '학업계획서 및 활동 증빙 서류 반영' }] },
    schedule: { title: '제출 서류·일정', list: [{ label: '원서 접수', text: '12월 초~중순' }, { label: '필기고사', text: '1월 둘째 주 실시' }] },
    source: 'https://admission.skku.edu'
  },
  '한양대학교': {
    qualification: { title: '지원 자격·학점', list: [{ label: '지원 대상', text: '2학년 4학기 이상 수료자' }, { label: '이수 학점 기준', text: '전적대학 수료 인정 학점(보통 66~70학점) 이상' }] },
    exam: { title: '시험 과목·범위', list: [{ label: '필답고사', text: '자연계열: 영어(40문항 70분) + 수학(25문항 90분)' }, { label: '2단계', text: '필기 70% + 전적대 서류평가 30%' }] },
    language: { title: '어학·자격증', list: [{ label: '공인영어', text: '자체 영어시험 치르므로 토익 불필요' }, { label: '기타 자격', text: '공학인증 관련 서류 필요 시 제출' }] },
    schedule: { title: '제출 서류·일정', list: [{ label: '원서 접수', text: '12월 중순 예정' }, { label: '합격자 발표', text: '2월 초' }] },
    source: 'https://go.hanyang.ac.kr'
  }
};

const defaultTargetDB = (uni, unit, year, type) => ({
  qualification: { title: '지원 자격·학점', list: [{ label: '지원 대상', text: `${uni} 편입학 기본 자격 충족자 (2학년 수료)` }, { label: '이수 학점', text: '통상 65~70학점 이상 취득 권장' }] },
  exam: { title: '시험 과목·범위', list: [{ label: '전형 요소', text: `${unit} 필기시험 또는 서류평가 전형 실시` }, { label: '반영 비율', text: '1단계 필기 100% / 2단계 면접 또는 서류' }] },
  language: { title: '어학·자격증', list: [{ label: '공인영어', text: '입학처 최신 요강 기준에 따름' }, { label: '가산점', text: '자격증 가산점 공지 확인' }] },
  schedule: { title: '제출 서류·일정', list: [{ label: '원서 접수', text: '12월 중 예정' }, { label: '서류 제출', text: '성적 및 수료증명서 제출' }] },
  source: `https://search.naver.com/search.naver?query=${encodeURIComponent(uni + ' 입학처')}`
});

// 기본 목표 대학 데이터
const defaults = {
  activeTargetIndex: 0,
  targets: [
    {
      id: 1,
      university: '인하대학교',
      year: '2027',
      type: '일반편입',
      unit: '컴퓨터공학과',
      checks: [true, false, false, false],
      notes: { 0: '전적대 68학점 이수 확인 완료' }
    },
    {
      id: 2,
      university: '성균관대학교',
      year: '2027',
      type: '일반편입',
      unit: '소프트웨어학과',
      checks: [false, false, false, false],
      notes: {}
    },
    {
      id: 3,
      university: '한양대학교',
      year: '2027',
      type: '일반편입',
      unit: '컴퓨터소프트웨어학부',
      checks: [true, true, false, false],
      notes: {}
    }
  ]
};

let state;
try {
  state = { ...defaults, ...JSON.parse(localStorage.getItem(KEY) || '{}') };
  if (!state.targets || state.targets.length === 0) state.targets = [...defaults.targets];
} catch (e) {
  state = { ...defaults };
}

let page = 'home';
let detailCategoryKey = 'qualification';
const years = Array.from({ length: 11 }, (_, i) => String(2020 + i));

function save() {
  localStorage.setItem(KEY, JSON.stringify(state));
}

function toast(msg = '저장되었습니다.') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1600);
}

function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

function getActiveTarget() {
  if (!state.targets.length) return null;
  const idx = Math.min(Math.max(state.activeTargetIndex || 0, 0), state.targets.length - 1);
  return state.targets[idx];
}

function getTargetProgress(target) {
  if (!target || !target.checks) return 0;
  return Math.round(target.checks.filter(Boolean).length / 4 * 100);
}

function setPage(p) {
  page = p;
  render();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function titlebar(title, step = '', showBack = true) {
  const backBtn = showBack ? `<button class="back" onclick="goBack()" aria-label="뒤로">←</button>` : '';
  const note = step ? `<span class="header-note">${step}</span>` : '';
  return `<div class="topline">${backBtn}<h2>${title}</h2>${note}</div>`;
}

function goBack() {
  if (page === 'detail') setPage('list');
  else if (page === 'list' || page === 'check' || page === 'search') setPage('home');
  else setPage('home');
}

function render() {
  document.querySelectorAll('.nav').forEach(b => {
    b.classList.toggle('active', b.dataset.page === (page === 'detail' ? 'list' : page));
  });
  
  const el = document.getElementById('screen');
  if (page === 'home') {
    el.innerHTML = home();
    initDragAndDrop(); // 홈 화면 렌더 후 드래그 앤 드롭 이벤트 바인딩
  }
  if (page === 'search') el.innerHTML = search();
  if (page === 'list') el.innerHTML = list();
  if (page === 'detail') el.innerHTML = detail();
  if (page === 'check') el.innerHTML = check();
  if (page === 'profile') el.innerHTML = profile();
}

/* =========================================================
   1. 홈 화면 (Home) - 드래그 순위 변경 지원
   ========================================================= */
function home() {
  const activeTarget = getActiveTarget();
  const currentProg = activeTarget ? getTargetProgress(activeTarget) : 0;
  
  const top3 = state.targets.slice(0, 3);
  const badgesHtml = top3.map((t, idx) => `
    <div class="rank-badge ${state.activeTargetIndex === idx ? 'active' : ''}" onclick="selectActiveTarget(${idx})">
      <span><b>${idx + 1}순위</b> ${esc(t.university)}</span>
      <small>${getTargetProgress(t)}%</small>
    </div>
  `).join('');

  return `
  <div class="eyebrow">AI TRANSFER PREP · DASHBOARD</div>
  <h1>편입 준비,<br>한눈에 확인하세요.</h1>
  <p class="sub">목표 대학의 최신 요강 조건을 AI 비서와 함께 점검해 보세요.</p>
  
  <div class="hero">
    <h2>새로운 목표 대학 추가하기</h2>
    <p>대학과 학과를 입력하면 AI가 입학처 공지를 탐색해 필요한 준비 조건을 채워줍니다.</p>
    <button class="btn" onclick="setPage('search')">+ 목표 대학 추가 / 분석 →</button>
  </div>

  <div class="stats">
    <div class="stat">
      <strong>${currentProg}%</strong>
      <span>선택 대학 체크 진행률</span>
      <div class="progress"><i style="width:${currentProg}%"></i></div>
    </div>
    <div class="stat">
      <span style="font-size:10px;color:var(--muted);font-weight:700">목표 대학 순위 (탭하여 전환)</span>
      <div class="rank-badges">
        ${badgesHtml || '<div style="font-size:11px;color:#888;padding:4px">목표를 추가하세요</div>'}
      </div>
    </div>
  </div>

  <div class="section-head">
    <h3>현재 선택: ${activeTarget ? esc(activeTarget.university) : '미선택'}</h3>
    <span class="header-note">QUICK MENU</span>
  </div>
  <div class="grid">
    <button class="tile" onclick="openDetailCategory('qualification')"><b>지원 자격·학점</b><span>자격 기준 확인 →</span></button>
    <button class="tile" onclick="openDetailCategory('exam')"><b>시험 과목·범위</b><span>필답고사 범위 →</span></button>
    <button class="tile" onclick="openDetailCategory('language')"><b>어학·자격증</b><span>공인어학 기준 →</span></button>
    <button class="tile" onclick="openDetailCategory('schedule')"><b>제출 서류·일정</b><span>원서 일정 안내 →</span></button>
  </div>

  <div class="section-head" style="margin-top:24px">
    <div>
      <h3 style="margin:0">나의 목표 대학 현황 (${state.targets.length}곳)</h3>
      <p style="font-size:11px;color:var(--muted);margin:2px 0 0">우측 핸들(≡)을 눌러 순위를 위아래로 변경할 수 있어요.</p>
    </div>
    <button class="btn small secondary" onclick="setPage('search')">+ 추가</button>
  </div>
  
  <div class="target-list" id="targetListContainer">
    ${state.targets.map((t, idx) => `
      <div class="target-card" 
           data-index="${idx}" 
           draggable="false"
           style="${state.activeTargetIndex === idx ? 'border-color:var(--accent);border-width:2px;' : ''}">
        <div class="target-card-header">
          <div style="display:flex;align-items:center;gap:6px">
            <span class="badge-priority p${idx + 1}">${idx + 1}순위 목표</span>
            <span style="font-size:12px;font-weight:700;color:var(--muted)">진행률 ${getTargetProgress(t)}%</span>
          </div>
          <!-- 드래그 핸들 (≡ 아이콘) -->
          <div class="drag-handle" title="길게 눌러 순서 변경" aria-label="순서 변경 핸들">≡</div>
        </div>
        <b style="font-size:15px;color:var(--ink)">${esc(t.university)} · ${esc(t.unit)}</b>
        <p class="sub" style="margin:4px 0 10px">${esc(t.year)}학년도 · ${esc(t.type)}</p>
        <div class="actions" style="margin-top:8px">
          <button class="btn small ${state.activeTargetIndex === idx ? 'ghost' : 'secondary'}" onclick="selectActiveTarget(${idx})">
            ${state.activeTargetIndex === idx ? '✓ 현재 선택됨' : '이 대학 선택'}
          </button>
          <button class="btn small secondary" onclick="goToTargetCheck(${idx})">체크리스트</button>
          <button class="btn small danger" style="flex:0.4" onclick="removeTarget(${idx})">삭제</button>
        </div>
      </div>
    `).join('')}
  </div>`;
}

/* =========================================================
   드래그 앤 드롭 (Drag & Drop / Touch Reorder) 로직
   ========================================================= */
function initDragAndDrop() {
  const container = document.getElementById('targetListContainer');
  if (!container) return;

  const cards = container.querySelectorAll('.target-card');
  let draggedCard = null;
  let startIndex = -1;

  cards.forEach(card => {
    const handle = card.querySelector('.drag-handle');
    if (!handle) return;

    // --- PC 마우스 드래그 ---
    handle.addEventListener('mousedown', () => {
      card.setAttribute('draggable', 'true');
    });

    card.addEventListener('dragstart', (e) => {
      draggedCard = card;
      startIndex = parseInt(card.dataset.index, 10);
      card.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
    });

    card.addEventListener('dragend', () => {
      card.classList.remove('dragging');
      card.setAttribute('draggable', 'false');
      cards.forEach(c => c.classList.remove('drag-over'));
    });

    card.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      if (card !== draggedCard) {
        cards.forEach(c => c.classList.remove('drag-over'));
        card.classList.add('drag-over');
      }
    });

    card.addEventListener('drop', (e) => {
      e.preventDefault();
      const targetIndex = parseInt(card.dataset.index, 10);
      if (draggedCard && startIndex !== targetIndex) {
        reorderTargets(startIndex, targetIndex);
      }
    });

    // --- 모바일 터치 드래그 (Touch Drag) ---
    let touchStartY = 0;
    let isTouching = false;

    handle.addEventListener('touchstart', (e) => {
      isTouching = true;
      draggedCard = card;
      startIndex = parseInt(card.dataset.index, 10);
      touchStartY = e.touches[0].clientY;
      card.classList.add('dragging');
    }, { passive: true });

    handle.addEventListener('touchmove', (e) => {
      if (!isTouching) return;
      const currentY = e.touches[0].clientY;
      const elementBelow = document.elementFromPoint(e.touches[0].clientX, currentY);
      const targetCardBelow = elementBelow ? elementBelow.closest('.target-card') : null;

      cards.forEach(c => c.classList.remove('drag-over'));
      if (targetCardBelow && targetCardBelow !== draggedCard) {
        targetCardBelow.classList.add('drag-over');
      }
    }, { passive: true });

    handle.addEventListener('touchend', (e) => {
      if (!isTouching) return;
      isTouching = false;
      card.classList.remove('dragging');
      
      const lastTouch = e.changedTouches[0];
      const elementBelow = document.elementFromPoint(lastTouch.clientX, lastTouch.clientY);
      const targetCardBelow = elementBelow ? elementBelow.closest('.target-card') : null;

      cards.forEach(c => c.classList.remove('drag-over'));

      if (targetCardBelow && targetCardBelow !== draggedCard) {
        const targetIndex = parseInt(targetCardBelow.dataset.index, 10);
        reorderTargets(startIndex, targetIndex);
      }
    });
  });
}

// 순위 배열 재배치 함수
function reorderTargets(fromIdx, toIdx) {
  const currentActiveId = state.targets[state.activeTargetIndex]?.id;
  const movedItem = state.targets.splice(fromIdx, 1)[0];
  state.targets.splice(toIdx, 0, movedItem);

  // 현재 보고 있던 대학 활성 인덱스 동기화
  if (currentActiveId) {
    const newActiveIdx = state.targets.findIndex(t => t.id === currentActiveId);
    state.activeTargetIndex = newActiveIdx !== -1 ? newActiveIdx : 0;
  }

  save();
  render();
  toast(`목표 대학 순위가 재설정되었습니다. (1순위: ${state.targets[0].university})`);
}

function selectActiveTarget(idx) {
  state.activeTargetIndex = idx;
  save();
  render();
  toast(`${idx + 1}순위 대학으로 전환되었습니다.`);
}

function goToTargetCheck(idx) {
  state.activeTargetIndex = idx;
  save();
  setPage('check');
}

function removeTarget(idx) {
  if (confirm(`'${state.targets[idx].university}' 목표를 삭제하시겠습니까?`)) {
    state.targets.splice(idx, 1);
    if (state.activeTargetIndex >= state.targets.length) {
      state.activeTargetIndex = Math.max(0, state.targets.length - 1);
    }
    save();
    render();
    toast('목표 대학이 삭제되었습니다.');
  }
}

function openDetailCategory(key) {
  detailCategoryKey = key;
  setPage('detail');
}

/* 2. 조건 선택 및 AI 요강 분석 시뮬레이션 (Search) */
function search() {
  return `
  ${titlebar('목표 대학 추가 / 요강 탐색', '1 / 4', true)}
  <div class="progress"><i style="width:25%"></i></div>
  <h1 style="font-size:20px">편입 목표 대학을 입력하면<br>AI가 최신 요강을 수집합니다.</h1>
  <p class="sub">입학처 공지사항을 스캔하여 전형 기준을 자동으로 구성합니다.</p>
  
  <label for="uni">목표 대학</label>
  <select id="uni">
    <option value="">대학을 선택하세요</option>
    ${['인하대학교','성균관대학교','한양대학교','중앙대학교','연세대학교','고려대학교','서강대학교','기타 대학'].map(x => `<option>${x}</option>`).join('')}
  </select>

  <label for="year">모집연도</label>
  <select id="year">
    ${years.map(x => `<option ${x === '2027' ? 'selected' : ''}>${x}학년도</option>`).join('')}
  </select>

  <label for="type">편입 전형</label>
  <select id="type">
    <option value="일반편입">일반편입</option>
    <option value="학사편입">학사편입</option>
    <option value="특별전형">특별전형 (농어촌/특성화 등)</option>
  </select>

  <label for="unit">목표 모집단위(학과)</label>
  <input id="unit" type="text" placeholder="예: 컴퓨터공학과 / 경영학과" value="">

  <div class="info" style="margin-top:16px">
    🤖 <strong>AI 비서 요강 탐색 시뮬레이션:</strong> 아래 버튼을 누르면 AI가 입학처의 공지사항과 모집요강 문서를 가상으로 스캔하여 전형 조건을 즉시 채워 넣습니다.
  </div>

  <div class="actions">
    <button class="btn secondary" onclick="setPage('home')">취소</button>
    <button class="btn" onclick="startAiAnalysis()">🤖 AI 요강 탐색 & 추가 →</button>
  </div>`;
}

function startAiAnalysis() {
  const uni = document.getElementById('uni').value;
  const year = document.getElementById('year').value.replace('학년도', '');
  const type = document.getElementById('type').value;
  const unit = document.getElementById('unit').value.trim();

  if (!uni || !year || !type || !unit) {
    toast('모든 조건을 선택·입력해주세요.');
    return;
  }

  const modal = document.getElementById('aiModal');
  const bar = document.getElementById('aiProgressBar');
  const title = document.getElementById('aiModalTitle');
  const desc = document.getElementById('aiModalDesc');
  
  modal.classList.add('show');
  bar.style.width = '30%';
  title.textContent = `[${uni}] 입학처 접속 중...`;
  desc.textContent = `최신 편입학 모집요강 문서를 탐색하고 있습니다.`;

  setTimeout(() => {
    bar.style.width = '70%';
    title.textContent = `전형 조건 테이블 파싱 중...`;
    desc.textContent = `${unit} (${type}) 지원 자격 및 시험 과목을 추출합니다.`;
  }, 700);

  setTimeout(() => {
    bar.style.width = '100%';
    title.textContent = `분석 완료!`;
    desc.textContent = `성공적으로 목표 대학 준비 목록에 추가되었습니다.`;
  }, 1400);

  setTimeout(() => {
    modal.classList.remove('show');
    bar.style.width = '0%';
    
    state.targets.push({
      id: Date.now(),
      university: uni,
      year: year,
      type: type,
      unit: unit,
      checks: [false, false, false, false],
      notes: {}
    });
    state.activeTargetIndex = state.targets.length - 1;
    save();
    setPage('list');
    toast(`'${uni}' 요강이 성공적으로 등록되었습니다.`);
  }, 1900);
}

/* 3. 준비사항 요약 목록 (List) */
function list() {
  const target = getActiveTarget();
  if (!target) {
    return `<div class="card"><p>등록된 목표 대학이 없습니다.</p><button class="btn" onclick="setPage('search')">+ 목표 대학 추가</button></div>`;
  }

  const uniData = MOCK_ADMISSION_DATA[target.university] || defaultTargetDB(target.university, target.unit, target.year, target.type);

  return `
  ${titlebar('편입 준비사항 요약', '2 / 4', true)}
  <div class="progress"><i style="width:50%"></i></div>
  
  <div class="tab-scroll-container">
    ${state.targets.map((t, idx) => `
      <button class="pill-tab ${state.activeTargetIndex === idx ? 'active' : ''}" onclick="selectActiveTarget(${idx})">
        ${idx + 1}순위: ${esc(t.university)}
      </button>
    `).join('')}
  </div>

  <div class="card" style="background:#f3f3f3">
    <b>${esc(target.university)} · ${esc(target.unit)}</b>
    <p class="sub" style="margin:4px 0 0">${esc(target.year)}학년도 · ${esc(target.type)}</p>
    <div style="margin-top:8px;font-size:11px;color:#2563eb;word-break:break-all">
      🔗 공식 출처: <a href="${uniData.source}" target="_blank" style="color:#2563eb">${uniData.source}</a>
    </div>
  </div>

  <p class="sub" style="margin-top:16px">AI 비서가 추출한 세부 기준을 확인하세요.</p>

  <button class="item" style="width:100%;text-align:left" onclick="openDetailCategory('qualification')">
    <span><b>지원 자격·학점</b><p>수료 학점 및 지원 자격</p></span>
    <span class="arrow">›</span>
  </button>
  <button class="item" style="width:100%;text-align:left" onclick="openDetailCategory('exam')">
    <span><b>시험 과목·범위</b><p>필답고사 과목 및 전형 배점</p></span>
    <span class="arrow">›</span>
  </button>
  <button class="item" style="width:100%;text-align:left" onclick="openDetailCategory('language')">
    <span><b>어학·자격증</b><p>공인어학성적 및 가산점 기준</p></span>
    <span class="arrow">›</span>
  </button>
  <button class="item" style="width:100%;text-align:left" onclick="openDetailCategory('schedule')">
    <span><b>제출 서류·일정</b><p>필수 제출 서류 및 전형 일정</p></span>
    <span class="arrow">›</span>
  </button>

  <div class="actions">
    <button class="btn secondary" onclick="setPage('search')">+ 목표 추가</button>
    <button class="btn" onclick="setPage('check')">체크리스트 확인 →</button>
  </div>`;
}

/* 4. 세부 기준 안내 화면 (Detail) */
function detail() {
  const target = getActiveTarget();
  if (!target) return setPage('home');

  const uniData = MOCK_ADMISSION_DATA[target.university] || defaultTargetDB(target.university, target.unit, target.year, target.type);
  const catData = uniData[detailCategoryKey];
  const catIndexMap = { 'qualification': 0, 'exam': 1, 'language': 2, 'schedule': 3 };
  const currentCatIdx = catIndexMap[detailCategoryKey];
  const currentNote = target.notes[currentCatIdx] || '';

  return `
  ${titlebar(catData.title, '3 / 4', true)}
  <div class="progress"><i style="width:75%"></i></div>
  <p class="sub">${esc(target.university)} · ${esc(target.unit)} (${esc(target.type)})</p>
  <span class="status-badge">AI 비서 추출 기준</span>
  <h2>${catData.title}</h2>

  <div class="guide-box">
    ${catData.list.map(g => `
      <div class="guide-row">
        <strong>• ${esc(g.label)}</strong>
        <p>${esc(g.text)}</p>
      </div>
    `).join('')}
  </div>

  <div class="info">
    💡 입학처 공식 공지사항을 바탕으로 정리된 내용입니다. 특이 변동 사항은 모집요강 원문을 다시 한번 확인해 주세요.
  </div>

  <label for="detailNote">나만의 확인 메모</label>
  <input type="text" id="detailNote" placeholder="예: 전적대 68학점 충족 완료 / 12월 15일 원서 접수 알람 설정" value="${esc(currentNote)}">
  
  <div class="actions" style="margin-top:14px">
    <button class="btn secondary" onclick="setPage('list')">목록으로</button>
    <button class="btn" onclick="saveTargetNote(${currentCatIdx})">메모 저장</button>
  </div>

  <div class="section-head">
    <button class="btn secondary small" onclick="cycleDetailCategory(-1)">← 이전 항목</button>
    <button class="btn secondary small" onclick="cycleDetailCategory(1)">다음 항목 →</button>
  </div>
  <button class="btn ghost" style="margin-top:10px" onclick="setPage('check')">체크리스트로 이동 →</button>`;
}

function cycleDetailCategory(dir) {
  const keys = ['qualification', 'exam', 'language', 'schedule'];
  let idx = keys.indexOf(detailCategoryKey);
  idx = (idx + dir + keys.length) % keys.length;
  detailCategoryKey = keys[idx];
  render();
}

function saveTargetNote(catIdx) {
  const target = getActiveTarget();
  if (target) {
    target.notes[catIdx] = document.getElementById('detailNote').value.trim();
    save();
    toast('메모가 저장되었습니다.');
  }
}

/* 5. 대학별 독립 체크리스트 (Checklist) */
function check() {
  const target = getActiveTarget();
  if (!target) {
    return `<div class="card"><p>등록된 목표 대학이 없습니다.</p><button class="btn" onclick="setPage('search')">+ 목표 대학 추가</button></div>`;
  }

  const n = target.checks.filter(Boolean).length;
  const targetIdx = state.activeTargetIndex;

  return `
  ${titlebar('내 준비 체크리스트', '4 / 4', true)}
  <div class="progress"><i style="width:100%"></i></div>

  <div class="tab-scroll-container">
    ${state.targets.map((t, idx) => `
      <button class="pill-tab ${state.activeTargetIndex === idx ? 'active' : ''}" onclick="selectActiveTarget(${idx})">
        ${idx + 1}순위: ${esc(t.university)}
      </button>
    `).join('')}
  </div>

  <div class="card" style="background:#f2f2f2">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <b>${targetIdx + 1}순위: ${esc(target.university)}</b>
      <span style="font-size:12px;font-weight:700;color:var(--muted)">${n} / 4개 완료</span>
    </div>
    <h1 style="font-size:26px;margin:6px 0">${Math.round(n / 4 * 100)}%</h1>
    <div class="progress"><i style="width:${n / 4 * 100}%"></i></div>
  </div>

  ${['지원 자격 및 이수 학점 충족 확인', '필답고사 출제 범위 및 배점 확인', '공인어학성적 요건 충족 확인', '제출 서류 및 원서 접수 일정 확인'].map((label, i) => `
    <label class="check-row">
      <input type="checkbox" ${target.checks[i] ? 'checked' : ''} onchange="toggleTargetCheck(${targetIdx}, ${i}, this.checked)">
      <span>
        ${label}
        <small>${target.checks[i] ? '✓ 확인 완료' : '미확인 (클릭하여 체크)'}</small>
      </span>
    </label>
  `).join('')}

  <div class="info">
    💡 체크리스트는 각 목표 대학별로 개별 보관됩니다. 상단 탭을 전환하여 대학별 진행 상태를 비교해 보세요.
  </div>

  <div class="actions">
    <button class="btn secondary" onclick="setPage('list')">준비사항 보기</button>
    <button class="btn" onclick="setPage('home')">홈으로</button>
  </div>
  <button class="btn ghost" style="margin-top:10px" onclick="resetTargetChecks(${targetIdx})">이 대학 체크 초기화</button>`;
}

function toggleTargetCheck(targetIdx, checkIdx, val) {
  state.targets[targetIdx].checks[checkIdx] = val;
  save();
  render();
  toast('체크 상태가 저장되었습니다.');
}

function resetTargetChecks(targetIdx) {
  if (confirm(`'${state.targets[targetIdx].university}' 체크 상태를 초기화하시겠습니까?`)) {
    state.targets[targetIdx].checks = [false, false, false, false];
    save();
    render();
    toast('체크가 초기화되었습니다.');
  }
}

/* 6. 설정 및 1순위 대학 엠블럼 워터마크 화면 (Profile) */
function profile() {
  const top1Target = state.targets[0] || null;
  const uniName = top1Target ? top1Target.university : '미지정';
  const emblemSvg = EMBLEMS[uniName] || EMBLEMS['default'];

  return `
  ${titlebar('설정 및 데이터 관리', '', false)}
  <h1 style="font-size:20px">내 정보와 저장 데이터</h1>
  <p class="sub">선택한 조건과 메모는 기기 브라우저에 안전하게 보관됩니다.</p>
  
  <div class="emblem-card">
    <div class="emblem-watermark">${emblemSvg}</div>
    <div class="emblem-content">
      <span class="badge-priority p1" style="margin-bottom:8px;display:inline-block">🥇 1순위 대표 목표 대학교</span>
      <h2 style="font-size:22px;margin:4px 0 6px">${esc(uniName)}</h2>
      <p style="font-size:13px;color:#555;margin:0">
        ${top1Target ? `${esc(top1Target.year)}학년도 · ${esc(top1Target.type)}<br><b>${esc(top1Target.unit)}</b>` : '홈에서 1순위 목표 대학을 등록하세요.'}
      </p>
    </div>
  </div>

  <div class="section-head" style="margin-top:24px"><h3>데이터 백업 및 관리</h3></div>
  <button class="btn secondary" onclick="exportData()">내 데이터 백업하기 (JSON)</button>
  
  <label for="importFile" style="margin-top:14px">백업 파일 불러오기</label>
  <input type="file" id="importFile" accept=".json,application/json">
  <button class="btn secondary" style="margin-top:10px" onclick="importData()">백업 데이터 복원</button>
  <button class="btn ghost danger" style="margin-top:16px" onclick="clearAll()">설정 초기화 (전체 데이터 삭제)</button>

  <div class="info" style="margin-top:16px">
    💡 현재 버전은 다중 목표 대학, 순위 드래그 변경, AI 비서 요강 시뮬레이션이 적용된 와이어프레임 최신 단일 파일 버전입니다.
  </div>`;
}

function exportData() {
  let blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
  let a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = '편입준비_다중대학_백업.json';
  a.click();
  URL.revokeObjectURL(a.href);
  toast('백업 파일이 생성되었습니다.');
}

function importData() {
  let f = document.getElementById('importFile').files[0];
  if (!f) { toast('백업 파일을 먼저 선택해주세요.'); return; }
  let r = new FileReader();
  r.onload = () => {
    try {
      let d = JSON.parse(r.result);
      state = { ...defaults, ...d };
      save();
      setPage('home');
      toast('데이터를 성공적으로 복원했습니다.');
    } catch (e) {
      toast('올바른 백업 파일이 아닙니다.');
    }
  };
  r.readAsText(f);
}

function clearAll() {
  if (confirm('저장된 모든 목표 대학 정보와 체크 상태를 초기화하시겠습니까?')) {
    state = { ...defaults };
    save();
    setPage('home');
    toast('모든 데이터가 초기화되었습니다.');
  }
}

document.querySelectorAll('.nav').forEach(b => {
  b.addEventListener('click', () => setPage(b.dataset.page));
});

render();
</script>
</body>
</html>
